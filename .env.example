# =====================================================================
# VAPEHAUS APPLICATION ENVIRONMENT CONFIGURATION
# =====================================================================

# ── Application ───────────────────────────────────────────────────────
APP_NAME=VAPEHAUS
APP_ENV=local
APP_URL=http://localhost/vapehaus/public
APP_DEBUG=true
APP_SECRET_KEY=vapehaus_secret_jwt_key_2026_super_secure

# ── Database ──────────────────────────────────────────────────────────
# Option 1: SQLite (default zero-config local dev)
DB_DRIVER=sqlite

# Option 2: MySQL (XAMPP local dev)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vapehaus_db
# DB_USERNAME=root
# DB_PASSWORD=

# Option 3: PostgreSQL (Supabase / Render production)
# DB_DRIVER=pgsql
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres

# ── Supabase Configuration ───────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Authentication & Sessions ─────────────────────────────────────────
SESSION_LIFETIME_HOURS=24
JWT_SECRET=vapehaus_secret_jwt_key_2026_super_secure

# ── Regulatory Age Compliance (RA 11900) ──────────────────────────────
MINIMUM_LEGAL_AGE=18

# ── E-Commerce Logistics (PHP Currency) ───────────────────────────────
SHIPPING_STANDARD_FEE=150.00
SHIPPING_EXPRESS_FEE=250.00
SHIPPING_FREE_THRESHOLD=1500.00

# ── Payment Gateway (PayMongo) ────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_PUBLIC_KEY=pk_test_...
PAYMONGO_WEBHOOK_SECRET=whsec_vapehaus_secret_2026
